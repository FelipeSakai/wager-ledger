{
  "name": "wager-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering transaction processor",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "scripts": {
    "setup:env": "bun scripts/setup-env.ts",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "bun dist/main.js",
    "typecheck": "bun run check:architecture && tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src/modules/financial/domain tests/unit",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "sqs:up": "docker compose up -d --wait localstack",
    "sqs:send": "bun scripts/send-sqs.ts",
    "sqs:setup": "bun scripts/setup-sqs.ts",
    "worker:outbox": "bun src/bootstrap/outbox-worker.ts",
    "outbox:inspect": "bun scripts/outbox-recovery.ts inspect",
    "outbox:resume": "bun scripts/outbox-recovery.ts resume",
    "worker:sqs": "bun src/bootstrap/sqs-worker.ts",
    "dlq:inspect": "bun scripts/dlq-recovery.ts inspect",
    "dlq:resume": "bun scripts/dlq-recovery.ts resume",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:list": "bun scripts/migrate.ts list",
    "worker:references": "bun src/bootstrap/reference-worker.ts",
    "references:failures": "bun scripts/reference-failures.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "setup": "bun scripts/setup-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1157.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3"
  }
}
