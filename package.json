{
  "name": "wager-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering transaction processor",
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4 <2" },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "bun dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
